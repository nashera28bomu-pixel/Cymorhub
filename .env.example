# FrameX catalog API key (server-side only, never exposed to the browser)
FRAMEX_API_KEY=your_framex_api_key_here

# Optional preferred HTTPS origin for catalog authentication retries.
# If unset, the catalog route uses the incoming CymorFlix host, then www/apex.
# SITE_URL=https://www.cymortechservices.my.id

# The FrameX request origin defaults to CymorFlix's registered domain.
# Set this only if your FrameX key is registered for a different HTTPS origin.
# FRAMEX_SITE_ORIGIN=https://your-domain.example
